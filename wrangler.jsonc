{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a1-scout-docs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"], "not_found_handling": "404-page" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4ff5861af311480882cc02e7ec6c65de" }],
  "workers_dev": true,
  "routes": [{ "pattern": "scout.organizedai.vip", "custom_domain": true }],
  // Opt-in full transcripts from the connector, one prefix per workspace (src/connect.js).
  "r2_buckets": [
    { "binding": "TRANSCRIPTS", "bucket_name": "a1-scout-public-transcripts" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "a1-scout-waitlist", "database_id": "77f58d7b-6964-4659-a661-00251694092f" }
  ],
  "vars": {
    // Set these when ready; the page works without them.
    "SURVEY_URL": "",   // Typeform link shown after someone joins
    "GTM_ID": ""        // GTM-XXXXXXX; empty = no tag manager loaded
  },
  "observability": { "enabled": true }
}
